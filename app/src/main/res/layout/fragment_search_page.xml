<?xml version="1.0" encoding="utf-8"?>

<!--
  fragment_search_page.xml
  Objetivo: Ecrã de resultados de pesquisa.
  Estrutura:
  - Topo: botão Home + barra de pesquisa + botão User
  - Corpo: lista vertical de resultados
  - Secção inferior: recomendações em lista horizontal
  - Estados: loading e mensagem (vazio/erro)
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    tools:layout="@layout/fragment_search_page">

    <com.example.grupo_pdm.ui.components.TopBarView
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Mensagem para estados "vazio" ou "erro".
      - Começa oculta (gone).
      No futuro: pode mostrar "Sem resultados..." ou "Erro de rede...".
    -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="@string/msg_default"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      RecyclerView de RESULTADOS (vertical).
      - layout_height="0dp" + constraints => ocupa o espaço disponível até ao título "Recomendações".
      - paddingBottom + clipToPadding=false => evita que o último item fique colado/“cortado”.
      - tools:listitem / tools:itemCount => só para Preview (não afeta runtime).
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/tvRecommendations"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="8"
        tools:listitem="@layout/item_movie_result" />

    <!--
      Título da secção de Recomendações.
      - Fica imediatamente acima do RecyclerView horizontal.
      - Margens para dar "respiro" visual.
    -->
    <TextView
        android:id="@+id/tvRecommendations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_recommendations"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rvRecommendations" />

    <!--
      RecyclerView de RECOMENDAÇÕES (horizontal).
      - android:orientation="horizontal" + LinearLayoutManager => itens lado a lado.
      - Altura fixa (150dp) para controlar o tamanho da secção.
      - tools:* => apenas para Preview.
      No futuro: recebe lista de filmes recomendados (tema/género, etc).
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecommendations"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_movie_reco"
        tools:itemCount="6"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.constraintlayout.widget.ConstraintLayout>
