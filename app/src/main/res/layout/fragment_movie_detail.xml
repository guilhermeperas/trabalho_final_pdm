<?xml version="1.0" encoding="utf-8"?>

<!--
  fragment_movie_detail.xml (nome sugerido)
  Objetivo: Ecrã de detalhe de um filme específico.

  Estrutura geral:
  - Topo (igual à página de pesquisa): Home + barra de pesquisa + User
  - Corpo com scroll: poster, título/meta, sinopse, elenco, comentários
  - Comentários: lista + campo para escrever + botão enviar
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <!--
      ===== TOPO (mesmo padrão do SearchPage) =====
      - btnHome: voltar ao início do app
      - tilSearchDetail/etSearchDetail: permitir nova pesquisa a partir do detalhe
      - btnUser: abrir perfil/login
    -->

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_home"
        android:src="@drawable/ic_home_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btnUser"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_user"
        android:src="@drawable/ic_user_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--
      Barra de pesquisa para permitir pesquisar sem sair deste ecrã.
      - endIcon: ícone de lupa do lado direito (pode usar onClick para pesquisar)
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_search"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:endIconMode="custom"
        app:endIconDrawable="@android:drawable/ic_menu_search"
        app:layout_constraintStart_toEndOf="@id/btnHome"
        app:layout_constraintEnd_toStartOf="@id/btnUser"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchDetail"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
      ===== CONTEÚDO (com scroll) =====
      NestedScrollView permite rolar (scroll) o conteúdo todo:
      poster + texto + listas + comentários.
      fillViewport="true": faz o conteúdo ocupar o ecrã todo mesmo se for pequeno.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tilSearchDetail"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
          ConstraintLayout interno: organiza os elementos em sequência vertical usando constraints.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--
              Poster do filme (dentro de um Card para cantos arredondados).
              scaleType="centerCrop" corta e preenche sem distorcer a imagem.
              Altura fixa 220dp (pode ajustar se quiser mais/menos destaque).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPoster"
                android:layout_width="0dp"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/cd_poster"
                    android:src="@android:drawable/ic_menu_report_image"/>
            </com.google.android.material.card.MaterialCardView>

            <!--
              Título do filme (grande e em negrito).
              tools:text é só para preview (não afeta a app a correr).
            -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_marginTop="12dp"
                tools:text="Titanic"
                app:layout_constraintTop_toBottomOf="@id/cardPoster"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Meta info (ano • duração • género).
              alpha reduz a “força” do texto para ser secundário ao título.
            -->
            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:layout_marginTop="4dp"
                tools:text="1997 • 3h14 • Romance/Drama"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Título da secção de Sinopse.
              (Você escreveu "Synopsis" - pode trocar para "Sinopse" se quiser PT.)
            -->
            <TextView
                android:id="@+id/tvOverviewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_synopsis"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvMeta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Texto da sinopse.
              - Sem maxLines => pode ter várias linhas (como você queria).
              - lineSpacingExtra melhora a leitura.
            -->
            <TextView
                android:id="@+id/tvOverview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                tools:text="Uma história de amor a bordo do Titanic..."
                app:layout_constraintTop_toBottomOf="@id/tvOverviewTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Secção Elenco (título).
              (Você escreveu "Cast" - pode trocar para "Elenco".)
            -->
            <TextView
                android:id="@+id/tvCastTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_cast"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/tvOverview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              RecyclerView do elenco (horizontal).
              - LayoutManager Linear + orientation horizontal => itens lado a lado.
              - tools:listitem => mostra cards de exemplo no preview.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCast"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tvCastTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:itemCount="8"
                tools:listitem="@layout/item_cast"/>

            <!--
              Secção Comentários (título).
              (Você escreveu "Comments" - pode trocar para "Comentários".)
            -->
            <TextView
                android:id="@+id/tvCommentsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_comments"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/rvCast"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Lista de comentários (vertical, por padrão).
              - Altura fixa (220dp) para ficar “uma janela” de comentários.
              - tools:listitem => preview com items do layout item_comment.
              No futuro: este RV vai usar um Adapter com lista real de comentários.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tvCommentsTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:itemCount="4"
                tools:listitem="@layout/item_comment"/>

            <!--
              Campo para escrever um novo comentário.
              - maxLines=3 permite o texto crescer até 3 linhas.
              - InputType MultiLine permite Enter/quebra de linha.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_new_comment"
                app:layout_constraintTop_toBottomOf="@id/rvComments"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSendComment">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="1"
                    android:maxLines="3"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!--
              Botão de enviar comentário (ícone "send").
              No futuro: onClick pega o texto do etNewComment e adiciona à lista.
            -->
            <ImageButton
                android:id="@+id/btnSendComment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_send_comment"
                android:src="@android:drawable/ic_menu_send"
                app:layout_constraintTop_toTopOf="@id/tilNewComment"
                app:layout_constraintBottom_toBottomOf="@id/tilNewComment"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--
              Espaço final: evita o último elemento ficar colado no fim do ecrã
              (visual mais “respirado”).
            -->
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                app:layout_constraintTop_toBottomOf="@id/tilNewComment"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
