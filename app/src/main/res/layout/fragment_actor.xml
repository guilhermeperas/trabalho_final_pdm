<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.example.grupo_pdm.ui.components.TopBarView
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Foto do ator -->
        <ImageView
            android:id="@+id/imgActor"
            android:layout_width="100dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_actor_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBar" />

        <!-- Nome do ator -->
        <TextView
            android:id="@+id/txtActorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do Ator"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/imgActor"
            app:layout_constraintStart_toEndOf="@id/imgActor"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Informações -->
        <TextView
            android:id="@+id/txtActorInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nascimento: 01/01/1980\nNacionalidade: EUA"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtActorName"
            app:layout_constraintStart_toEndOf="@id/imgActor"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Directed Movies Title -->
        <TextView
            android:id="@+id/txtDirectedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Directed Movies"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/imgActor"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Directed Movies List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDirectedMovies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtDirectedTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Acting Roles Title -->
        <TextView
            android:id="@+id/txtRolesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acting Roles"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/rvDirectedMovies"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Acting Roles List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActorRoles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtRolesTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>